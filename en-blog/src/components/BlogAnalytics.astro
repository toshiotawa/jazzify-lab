---
const measurementId = import.meta.env.VITE_GA_MEASUREMENT_ID;
---

{measurementId && (
  <script is:inline define:vars={{ measurementId }}>
    if (document.documentElement.dataset.blogAnalyticsInitialized !== 'true') {
      document.documentElement.dataset.blogAnalyticsInitialized = 'true';
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      const analyticsScript = document.createElement('script');
      analyticsScript.async = true;
      analyticsScript.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
      document.head.appendChild(analyticsScript);
      window.gtag('js', new Date());
      window.gtag('config', measurementId, { send_page_view: false });
      window.gtag('event', 'page_view', {
        page_path: window.location.pathname,
        page_location: window.location.href,
        page_title: document.title,
      });
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest('[data-blog-cta]') : null;
        if (!(target instanceof HTMLAnchorElement)) return;
        window.gtag('event', 'blog_cta_click', {
          article_slug: target.dataset.articleSlug,
          article_category: target.dataset.articleCategory,
          cta_position: target.dataset.blogCta,
          cta_asset: target.dataset.ctaAsset,
          link_url: target.href,
          link_text: target.getAttribute('aria-label') || '',
        });
      });

      const progressPercent = (video) => {
        const duration = video.duration;
        const currentTime = video.currentTime;
        if (!Number.isFinite(duration) || duration <= 0) return 0;
        if (!Number.isFinite(currentTime) || currentTime < 0) return 0;
        return Math.min(100, Math.max(0, Math.round((currentTime / duration) * 100)));
      };
      const watchSeconds = (video) => {
        const currentTime = video.currentTime;
        if (!Number.isFinite(currentTime) || currentTime < 0) return 0;
        return Math.round(currentTime);
      };
      const promoContext = (container) => ({
        article_slug: container.dataset.articleSlug,
        article_category: container.dataset.articleCategory,
      });
      const mark = (container, key) => {
        if (container.dataset[key] === 'true') return false;
        container.dataset[key] = 'true';
        return true;
      };

      document.addEventListener('play', (event) => {
        const video = event.target;
        if (!(video instanceof HTMLVideoElement)) return;
        const container = video.closest('[data-promo-video]');
        if (!(container instanceof HTMLElement)) return;
        if (!mark(container, 'promoPlayed')) return;
        window.gtag('event', 'blog_promo_video_play', promoContext(container));
      }, true);

      document.addEventListener('ended', (event) => {
        const video = event.target;
        if (!(video instanceof HTMLVideoElement)) return;
        const container = video.closest('[data-promo-video]');
        if (!(container instanceof HTMLElement)) return;
        if (container.dataset.promoPlayed !== 'true') return;
        if (!mark(container, 'promoCompleted')) return;
        window.gtag('event', 'blog_promo_video_complete', {
          ...promoContext(container),
          progress_percent: 100,
          watch_seconds: Number.isFinite(video.duration) ? Math.round(video.duration) : watchSeconds(video),
        });
      }, true);

      const abandonPromoVideos = () => {
        document.querySelectorAll('[data-promo-video]').forEach((container) => {
          if (!(container instanceof HTMLElement)) return;
          if (container.dataset.promoPlayed !== 'true') return;
          if (container.dataset.promoCompleted === 'true') return;
          if (!mark(container, 'promoAbandoned')) return;
          const video = container.querySelector('.promo-video__player');
          if (!(video instanceof HTMLVideoElement)) return;
          window.gtag('event', 'blog_promo_video_abandon', {
            ...promoContext(container),
            progress_percent: progressPercent(video),
            watch_seconds: watchSeconds(video),
          });
        });
      };
      window.addEventListener('pagehide', abandonPromoVideos);
    }
  </script>
)}
